{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Swift file",
      "type": "shell",
      "command": "swift",
      "args": ["${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$swiftc"]
    }
  ]
}
